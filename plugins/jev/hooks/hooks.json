{
  "description": "Jev token saver: /jev commands, prompt routing, skill router, tool-call gate and (Codex) output trimmer.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev/hookmain.py\" SessionStart", "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev/hookmain.py\" UserPromptSubmit", "timeout": 6}]}],
    "PreToolUse": [{"matcher": "^(Bash|Read|Grep|Glob)$", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev/hookmain.py\" PreToolUse", "timeout": 4}]}],
    "PostToolUse": [{"matcher": "^(Bash|Read|Grep|Glob|Skill|Agent|Task|apply_patch|Edit|Write|MultiEdit|NotebookEdit)$", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev/hookmain.py\" PostToolUse", "timeout": 8}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev/hookmain.py\" PreCompact", "timeout": 4}]}],
    "PostCompact": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev/hookmain.py\" PostCompact", "timeout": 4}]}]
  }
}
